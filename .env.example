# Copie para `.env` (fora do git) e ajuste. Nada aqui é obrigatório para só construir e publicar o
# front: com `frontend/modelos-finais/` versionado, `npm run build` roda sem nenhuma destas variáveis.

# --- Pipeline (Python, AutoCAD, Blender) ---
# Pasta do terreno: raiz das fontes de verdade (DWG, fotos, GLBs do Blender).
TERRENO_DIR=<caminho da pasta do terreno>
# AutoCAD (accoreconsole.exe) e Blender (blender.exe); sem elas valem os caminhos padrão de instalação.
ACCORE=C:\Program Files\Autodesk\AutoCAD 2018\accoreconsole.exe
BLENDER=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe

# --- Publicação no Cloudflare (`npm run publicar`, em frontend/) ---
# Domínio do site, sem https:// (ex.: maquete.exemplo.com). Vazio: publica no workers.dev.
DOMINIO=
# Nome do Worker. Vazio: o do frontend/wrangler.jsonc.
WORKER_NOME=

# --- Opcionais, só para consulta e um teste ---
# Pasta que contém os repositórios de referência (cv_espelho_vendas, UFCIM-FRONT3D).
REPOS_DIR=
# Pasta do vault Obsidian com as notas de domínio.
VAULT_DIR=

# Cópia para `.env` (que não vai para o git) com os caminhos da sua máquina.

# Pasta do terreno (raiz das fontes de verdade: DWG, fotos, GLBs do Blender). Só o pipeline Python usa.
TERRENO_DIR=<caminho da pasta do terreno>
# AutoCAD (accoreconsole.exe) e Blender (blender.exe); sem elas valem os caminhos padrão de instalação.
ACCORE=C:\Program Files\Autodesk\AutoCAD 2018\accoreconsole.exe
BLENDER=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# Pasta que contém os repositórios de referência (cv_espelho_vendas, UFCIM-FRONT3D); só um teste opcional a lê.
REPOS_DIR=
# Pasta do vault Obsidian com as notas de domínio (só consulta humana).
VAULT_DIR=
# Domínio em que `npm run publicar` (em frontend/) coloca o Worker no Cloudflare.
DOMINIO=
